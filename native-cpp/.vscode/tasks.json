{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build Windows Debug",
      "type": "shell",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\build-windows.ps1",
        "-Configuration",
        "Debug",
        "-MingwRoot",
        "D:\\mingw64",
        "-RunTests"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$gcc"
    }
  ]
}
